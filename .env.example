DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=club_demo
POSTGRES_USER=club
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
# Keep stable across worker restarts; optionally separate from DJANGO_SECRET_KEY.
# COMMAND_HASH_KEY=another-persistent-random-secret
# Enable only after configuring HTTPS and trusted proxy headers.
SECURE_SSL_REDIRECT=0

# Bind publicly only on an approved demo/staging host; use HTTPS for remote access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Allows artificial catalog seed only for *_demo database. Does not reset data.
ENABLE_DEMO_SEED=0

# Optional club Telegram Business sources. Empty = not configured; never use KADI credentials.
P2P_WEBHOOK_SECRET=
P2P_BOT_TOKEN=
P2P_BACKEND_URL=http://127.0.0.1:8000
P2P_UZCARD_SENDER_IDS=
P2P_UZCARD_BUSINESS_CONNECTION_ID=
P2P_HUMO_SENDER_IDS=
P2P_HUMO_BUSINESS_CONNECTION_ID=
