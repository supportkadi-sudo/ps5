DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
# Keep stable across worker restarts; optionally separate from DJANGO_SECRET_KEY.
# COMMAND_HASH_KEY=another-persistent-random-secret
# Enable only after configuring HTTPS and trusted proxy headers.
SECURE_SSL_REDIRECT=0
