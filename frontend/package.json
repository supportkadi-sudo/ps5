{
  "name": "club-crm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/shared/api/schema.d.ts",
    "check:contract": "npm run generate:api && git diff --exit-code -- src/shared/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
